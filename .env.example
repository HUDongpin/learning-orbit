# Set locally; do not commit a real value. Docker Compose refuses to start without it.
LO_POSTGRES_PASSWORD=

# Local development browser and Mailpit (non-secret values). Cookie-backed flows
# require a local HTTPS terminator because authentication cookies stay Secure.
DATABASE_URL=postgres://learning_orbit:${LO_POSTGRES_PASSWORD}@127.0.0.1:55432/learning_orbit
LO_PUBLIC_BASE_ORIGIN=https://127.0.0.1:3000
LO_ALLOWED_ORIGINS=https://127.0.0.1:3000
LO_LOCAL_SAME_ORIGIN_PROXY=
# Optional comma-separated exact storage origins. This single non-secret value
# is validated by Fastify and injected by Next as the browser allowlist. Leave
# empty when no reviewed media Provider is configured; local preview remains
# available but upload controls fail closed with zero media database writes.
LO_STORAGE_BROWSER_ORIGINS=

# Server-side credentials for the private object store. All four are required
# together or none at all; a partly supplied transport refuses to start. With
# none, media routes answer a stable 503 and write nothing.
LO_STORAGE_ENDPOINT=
LO_STORAGE_BUCKET=
LO_STORAGE_REGION=us-east-1
LO_STORAGE_ACCESS_KEY_ID=
LO_STORAGE_SECRET_ACCESS_KEY=
LO_TRUSTED_PROXY_CIDRS=
LO_SMTP_HOST=127.0.0.1
LO_SMTP_PORT=1025
LO_SMTP_FROM=no-reply@learning-orbit.local
LO_WORKER_ID=local-worker-1
LO_SERVICE_ASSERTION_ISSUER=learning-orbit-local
LO_SERVICE_ASSERTION_KEY_ID=local-worker-key-1
LO_INTERNAL_BASE_ORIGIN=http://127.0.0.1:3001

# Required runtime secrets are intentionally blank in this committed example.
LO_ANALYTICS_PSEUDONYM_KEY=
LO_AUDIT_SALT=

# Versioned HMAC peppers for enumerable room and seat codes. Inject at deploy
# time; configure old versions during rotation, and never commit their values.
# Rotation is two-phase: first deploy the complete read set to every writer,
# then switch CURRENT_VERSION so concurrent writers share the same allocation view.
ROOM_CODE_PEPPER_CURRENT_VERSION=
ROOM_CODE_PEPPER_V1=

# External paths only: no keys or trust contents belong in this file.
LO_SERVICE_ASSERTION_TRUST_FILE=/run/learning-orbit/service-assertion-trust.json
LO_WORKER_ASSERTION_PRIVATE_KEY_FILE=/run/learning-orbit/worker-assertion-private.pem

# OpenTelemetry export. Both runtimes read the same two variables and derive
# the trace id from the correlation id already stored on room_event and
# worker_job, so a command's server spans and its worker spans land in one
# trace with no propagation header. Leave the endpoint blank to collect
# in-process and export nowhere: a missing collector must never block a
# classroom write. Point it only at the approved collector inside the private
# network; spans are redacted before export, but the endpoint is still a
# destination for operational metadata.
LO_ENVIRONMENT=development
LO_OTLP_ENDPOINT=
