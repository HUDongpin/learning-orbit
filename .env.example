# Set locally; do not commit a real value. Docker Compose refuses to start without it.
LO_POSTGRES_PASSWORD=

# Local development browser and Mailpit (non-secret values). Cookie-backed flows
# require a local HTTPS terminator because authentication cookies stay Secure.
DATABASE_URL=postgres://learning_orbit:${LO_POSTGRES_PASSWORD}@127.0.0.1:55432/learning_orbit
LO_PUBLIC_BASE_ORIGIN=http://127.0.0.1:3000
LO_ALLOWED_ORIGINS=http://127.0.0.1:3000
LO_TRUSTED_PROXY_CIDRS=
LO_SMTP_HOST=127.0.0.1
LO_SMTP_PORT=1025
LO_SMTP_FROM=no-reply@learning-orbit.local

# Versioned HMAC peppers for enumerable room and seat codes. Inject at deploy
# time; configure old versions during rotation, and never commit their values.
# Rotation is two-phase: first deploy the complete read set to every writer,
# then switch CURRENT_VERSION so concurrent writers share the same allocation view.
ROOM_CODE_PEPPER_CURRENT_VERSION=
ROOM_CODE_PEPPER_V1=

# External paths only: no keys or trust contents belong in this file.
LO_SERVICE_ASSERTION_TRUST_FILE=/run/learning-orbit/service-assertion-trust.json
LO_WORKER_ASSERTION_PRIVATE_KEY_FILE=/run/learning-orbit/worker-assertion-private.pem
