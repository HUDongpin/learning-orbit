{
  "name": "@learning-orbit/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false && node scripts/copy-sql-resources.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:migrate:test": "tsx src/db/migrate-cli.ts --test"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.0",
    "@learning-orbit/contracts": "workspace:*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fastify": "5.10.0",
    "nodemailer": "7.0.6",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  }
}
