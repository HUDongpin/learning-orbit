{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-orbit.local/schemas/echo-concept-projection.v1.json",
  "title": "EchoConceptProjection",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/ConceptMapSnapshot" },
    { "$ref": "#/$defs/ConceptMapPatch" }
  ],
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "start", "end"],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "TeacherConceptNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "nodeKind", "evidenceStatus", "reviewStatus", "displayStatus", "position"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nodeKind": { "const": "concept" },
        "evidenceStatus": { "enum": ["supported", "challenged", "uncertain", "disputed", "retracted", "superseded", "requires_replay"] },
        "reviewStatus": { "enum": ["unreviewed", "approved", "rejected", "corrected"] },
        "displayStatus": { "enum": ["confirmed", "provisional", "disputed", "inactive"] },
        "position": { "$ref": "#/$defs/Position" }
      }
    },
    "StudentConceptNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "nodeKind", "evidenceStatus", "reviewStatus", "displayStatus", "position"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nodeKind": { "const": "concept" },
        "evidenceStatus": { "enum": ["supported", "challenged", "uncertain", "disputed", "retracted", "superseded", "requires_replay"] },
        "reviewStatus": { "const": "approved" },
        "displayStatus": { "enum": ["confirmed", "provisional", "disputed", "inactive"] },
        "position": { "$ref": "#/$defs/Position" }
      }
    },
    "Channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "challenge", "uncertain", "question"],
      "properties": {
        "support": { "type": "number", "minimum": 0 },
        "challenge": { "type": "number", "minimum": 0 },
        "uncertain": { "type": "number", "minimum": 0 },
        "question": { "type": "number", "minimum": 0 }
      }
    },
    "TeacherConceptEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "head", "predicate", "tail", "relationFamily", "evidenceStatus", "reviewStatus", "displayStatus", "channels", "activityScore", "evidenceRefs"],
      "properties": {
        "edgeId": { "type": "string", "format": "uuid" },
        "head": { "type": "string", "minLength": 1, "maxLength": 160 },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tail": { "type": "string", "minLength": 1, "maxLength": 160 },
        "relationFamily": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidenceStatus": { "enum": ["supported", "challenged", "uncertain", "disputed", "retracted", "superseded", "requires_replay"] },
        "reviewStatus": { "enum": ["unreviewed", "approved", "rejected", "corrected"] },
        "displayStatus": { "enum": ["confirmed", "provisional", "disputed", "inactive"] },
        "channels": { "$ref": "#/$defs/Channels" },
        "activityScore": { "type": "number", "minimum": 0 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "StudentConceptEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "head", "predicate", "tail", "relationFamily", "evidenceStatus", "reviewStatus", "displayStatus"],
      "properties": {
        "edgeId": { "type": "string", "format": "uuid" },
        "head": { "type": "string", "minLength": 1, "maxLength": 160 },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tail": { "type": "string", "minLength": 1, "maxLength": 160 },
        "relationFamily": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidenceStatus": { "enum": ["supported", "challenged", "uncertain", "disputed", "retracted", "superseded", "requires_replay"] },
        "reviewStatus": { "const": "approved" },
        "displayStatus": { "enum": ["confirmed", "provisional", "disputed", "inactive"] }
      }
    },
    "Common": {
      "type": "object",
      "required": ["schemaVersion", "projectionKey", "roomId", "analysisEpoch", "algorithmVersion", "parameterHash", "projectionVersion", "baseVersion", "completeThroughRoomSeq", "watermarkEventTime", "requiresReplay", "evidenceStatus", "reviewStatus", "displayStatus", "warnings"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "projectionKey": { "enum": ["echo.teacher_shadow", "echo.student_approved"] },
        "roomId": { "type": "string", "format": "uuid" },
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "algorithmVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
        "parameterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "projectionVersion": { "type": "integer", "minimum": 1 },
        "baseVersion": { "type": "integer", "minimum": 0 },
        "completeThroughRoomSeq": { "type": "integer", "minimum": 0 },
        "watermarkEventTime": { "type": "string", "format": "date-time" },
        "requiresReplay": { "type": "boolean" },
        "evidenceStatus": { "enum": ["active", "retracted", "superseded", "requires_replay"] },
        "reviewStatus": { "enum": ["unreviewed", "approved", "rejected", "corrected"] },
        "displayStatus": { "enum": ["hidden", "teacher_shadow", "student_approved"] },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "TeacherConceptMapSnapshot": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "required": ["projectionKey", "displayStatus", "payload"],
          "properties": {
            "projectionKey": { "const": "echo.teacher_shadow" },
            "displayStatus": { "const": "teacher_shadow" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "edges"],
              "properties": {
                "nodes": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptNode" } },
                "edges": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptEdge" } }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "EmptyStudentConceptMapSnapshot": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "required": ["projectionKey", "reviewStatus", "displayStatus", "payload"],
          "properties": {
            "projectionKey": { "const": "echo.student_approved" },
            "reviewStatus": { "const": "unreviewed" },
            "displayStatus": { "const": "student_approved" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "edges"],
              "properties": {
                "nodes": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/StudentConceptNode" } },
                "edges": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/StudentConceptEdge" } }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApprovedStudentNodesConceptMapSnapshot": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "required": ["projectionKey", "reviewStatus", "displayStatus", "payload"],
          "properties": {
            "projectionKey": { "const": "echo.student_approved" },
            "reviewStatus": { "const": "approved" },
            "displayStatus": { "const": "student_approved" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "edges"],
              "properties": {
                "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StudentConceptNode" } },
                "edges": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptEdge" } }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApprovedStudentEdgesConceptMapSnapshot": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "required": ["projectionKey", "reviewStatus", "displayStatus", "payload"],
          "properties": {
            "projectionKey": { "const": "echo.student_approved" },
            "reviewStatus": { "const": "approved" },
            "displayStatus": { "const": "student_approved" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "edges"],
              "properties": {
                "nodes": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptNode" } },
                "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StudentConceptEdge" } }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApprovedStudentConceptMapSnapshot": {
      "anyOf": [
        { "$ref": "#/$defs/ApprovedStudentNodesConceptMapSnapshot" },
        { "$ref": "#/$defs/ApprovedStudentEdgesConceptMapSnapshot" }
      ]
    },
    "StudentConceptMapSnapshot": {
      "anyOf": [
        { "$ref": "#/$defs/EmptyStudentConceptMapSnapshot" },
        { "$ref": "#/$defs/ApprovedStudentConceptMapSnapshot" }
      ]
    },
    "ConceptMapSnapshot": {
      "anyOf": [
        { "$ref": "#/$defs/TeacherConceptMapSnapshot" },
        { "$ref": "#/$defs/StudentConceptMapSnapshot" }
      ]
    },
    "PositionUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "x", "y"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "TeacherConceptMapPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisEpoch", "algorithmVersion", "parameterHash", "projectionVersion", "baseVersion", "completeThroughRoomSeq", "requiresReplay", "warnings", "nodesAdded", "nodesUpdated", "nodesHidden", "edgesAdded", "edgesUpdated", "edgesHidden", "positionUpdates", "changeScore", "reasonCodes", "evidenceRefs"],
      "properties": {
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "algorithmVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
        "parameterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "projectionVersion": { "type": "integer", "minimum": 1 },
        "baseVersion": { "type": "integer", "minimum": 0 },
        "completeThroughRoomSeq": { "type": "integer", "minimum": 0 },
        "requiresReplay": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "nodesAdded": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptNode" } },
        "nodesUpdated": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptNode" } },
        "nodesHidden": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "edgesAdded": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptEdge" } },
        "edgesUpdated": { "type": "array", "items": { "$ref": "#/$defs/TeacherConceptEdge" } },
        "edgesHidden": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "positionUpdates": { "type": "array", "items": { "$ref": "#/$defs/PositionUpdate" } },
        "changeScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasonCodes": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "StudentConceptMapPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisEpoch", "algorithmVersion", "parameterHash", "projectionVersion", "baseVersion", "completeThroughRoomSeq", "requiresReplay", "warnings", "nodesAdded", "nodesUpdated", "nodesHidden", "edgesAdded", "edgesUpdated", "edgesHidden", "positionUpdates", "changeScore", "reasonCodes"],
      "properties": {
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "algorithmVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
        "parameterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "projectionVersion": { "type": "integer", "minimum": 1 },
        "baseVersion": { "type": "integer", "minimum": 0 },
        "completeThroughRoomSeq": { "type": "integer", "minimum": 0 },
        "requiresReplay": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "nodesAdded": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptNode" } },
        "nodesUpdated": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptNode" } },
        "nodesHidden": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "edgesAdded": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptEdge" } },
        "edgesUpdated": { "type": "array", "items": { "$ref": "#/$defs/StudentConceptEdge" } },
        "edgesHidden": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "positionUpdates": { "type": "array", "items": { "$ref": "#/$defs/PositionUpdate" } },
        "changeScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasonCodes": { "type": "array", "items": { "type": "string", "maxLength": 160 } }
      }
    },
    "ConceptMapPatch": {
      "anyOf": [
        { "$ref": "#/$defs/TeacherConceptMapPatch" },
        { "$ref": "#/$defs/StudentConceptMapPatch" }
      ]
    }
  }
}
