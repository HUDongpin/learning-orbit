{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-orbit.local/schemas/analytics-http.v1.json",
  "title": "AnalyticsHttpResponse",
  "oneOf": [
    { "$ref": "#/$defs/PatchPage" },
    { "$ref": "#/$defs/TimelineResponse" },
    { "$ref": "#/$defs/ResyncResponse" }
  ],
  "$defs": {
    "TeacherPatchPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "roomId", "projectionKey", "analysisEpoch", "patches"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roomId": { "type": "string", "format": "uuid" },
        "projectionKey": { "const": "echo.teacher_shadow" },
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "patches": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "echo-concept-projection.v1.json#/$defs/TeacherConceptMapPatch" }
        }
      }
    },
    "StudentPatchPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "roomId", "projectionKey", "analysisEpoch", "patches"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roomId": { "type": "string", "format": "uuid" },
        "projectionKey": { "const": "echo.student_approved" },
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "patches": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "echo-concept-projection.v1.json#/$defs/StudentConceptMapPatch" }
        }
      }
    },
    "PatchPage": {
      "anyOf": [
        { "$ref": "#/$defs/TeacherPatchPage" },
        { "$ref": "#/$defs/StudentPatchPage" }
      ]
    },
    "TeacherTimelineResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "roomId", "projectionKey", "analysisEpoch", "baseSnapshot", "patches", "truncatedBeforeVersion", "headVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roomId": { "type": "string", "format": "uuid" },
        "projectionKey": { "const": "echo.teacher_shadow" },
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "baseSnapshot": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "echo-concept-projection.v1.json#/$defs/TeacherConceptMapSnapshot" }
          ]
        },
        "patches": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "echo-concept-projection.v1.json#/$defs/TeacherConceptMapPatch" }
        },
        "truncatedBeforeVersion": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "headVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "StudentTimelineResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "roomId", "projectionKey", "analysisEpoch", "baseSnapshot", "patches", "truncatedBeforeVersion", "headVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roomId": { "type": "string", "format": "uuid" },
        "projectionKey": { "const": "echo.student_approved" },
        "analysisEpoch": { "type": "string", "format": "uuid" },
        "baseSnapshot": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "echo-concept-projection.v1.json#/$defs/StudentConceptMapSnapshot" }
          ]
        },
        "patches": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "echo-concept-projection.v1.json#/$defs/StudentConceptMapPatch" }
        },
        "truncatedBeforeVersion": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "headVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "TimelineResponse": {
      "anyOf": [
        { "$ref": "#/$defs/TeacherTimelineResponse" },
        { "$ref": "#/$defs/StudentTimelineResponse" }
      ]
    },
    "ResyncResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "snapshotUrl"],
      "properties": {
        "code": { "const": "SNAPSHOT_RESYNC_REQUIRED" },
        "snapshotUrl": {
          "type": "string",
          "pattern": "^/v1/rooms/[^/?#]+/analytics/(echo\\.(teacher_shadow|student_approved)|trace\\.(teacher_bundle|student_bundle))/latest$"
        }
      }
    }
  }
}
